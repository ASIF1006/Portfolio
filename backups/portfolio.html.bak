<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects & Portfolio | Shaik Mohammad Asif</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --navy: #0a0e27;
            --indigo: #1a1f4e;
            --emerald: #00f5a0;
            --emerald-dim: rgba(0, 245, 160, 0.15);
            --violet: #b388ff;
            --violet-dim: rgba(179, 136, 255, 0.15);
            --glass-bg: rgba(255, 255, 255, 0.04);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-glow: rgba(0, 245, 160, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.4);
            --font-sans: 'Inter Tight', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-sans);
            background: linear-gradient(135deg, var(--navy) 0%, var(--indigo) 50%, #12163a 100%);
            color: var(--text-primary);
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* ── AURORA BLOBS ── */
        .aurora-bg {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }
        .aurora-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.4;
            mix-blend-mode: screen;
        }
        .aurora-blob-1 {
            width: 600px; height: 600px;
            background: radial-gradient(circle, var(--emerald) 0%, transparent 70%);
            top: -200px; left: -150px;
            animation: auroraDrift1 12s ease-in-out infinite;
        }
        .aurora-blob-2 {
            width: 500px; height: 500px;
            background: radial-gradient(circle, var(--violet) 0%, transparent 70%);
            top: 30%; right: -200px;
            animation: auroraDrift2 15s ease-in-out infinite;
        }
        .aurora-blob-3 {
            width: 400px; height: 400px;
            background: radial-gradient(circle, var(--emerald) 0%, transparent 70%);
            bottom: -100px; left: 30%;
            animation: auroraDrift3 18s ease-in-out infinite;
        }
        .aurora-blob-4 {
            width: 350px; height: 350px;
            background: radial-gradient(circle, var(--violet) 0%, transparent 70%);
            top: 60%; left: -100px;
            animation: auroraDrift4 14s ease-in-out infinite;
        }

        @keyframes auroraDrift1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(100px, 80px) scale(1.15); }
            66% { transform: translate(-50px, 120px) scale(0.9); }
        }
        @keyframes auroraDrift2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(-80px, -60px) scale(1.1); }
            66% { transform: translate(60px, -100px) scale(0.95); }
        }
        @keyframes auroraDrift3 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(-60px, -80px) scale(1.2); }
            66% { transform: translate(80px, -40px) scale(0.85); }
        }
        @keyframes auroraDrift4 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(80px, 60px) scale(0.9); }
            66% { transform: translate(-40px, 80px) scale(1.1); }
        }

        /* ── PARTICLE CANVAS ── */
        #particleCanvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        /* ── GLASS UTILITY ── */
        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
        }
        .glass-glow {
            box-shadow: 0 0 30px var(--glass-glow), inset 0 1px 0 rgba(255,255,255,0.06);
        }
        .glass-glow:hover {
            border-color: rgba(0, 245, 160, 0.3);
            box-shadow: 0 0 40px rgba(0, 245, 160, 0.12), inset 0 1px 0 rgba(255,255,255,0.08);
        }
        .glass-glow-violet {
            box-shadow: 0 0 30px rgba(179, 136, 255, 0.06);
        }
        .glass-glow-violet:hover {
            border-color: rgba(179, 136, 255, 0.3);
            box-shadow: 0 0 40px rgba(179, 136, 255, 0.12);
        }

        /* ── NAVBAR ── */
        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            padding: 1.2rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent;
            transition: all 0.4s ease;
        }
        nav.scrolled {
            background: rgba(10, 14, 39, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 0.8rem 5%;
        }
        .logo {
            font-family: var(--font-sans);
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--text-primary);
            text-decoration: none;
            letter-spacing: 2px;
            background: linear-gradient(135deg, var(--emerald), var(--violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .nav-links { display: flex; gap: 2rem; align-items: center; }
        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: color 0.3s ease;
            position: relative;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px; left: 0;
            width: 0; height: 1.5px;
            background: linear-gradient(90deg, var(--emerald), var(--violet));
            transition: width 0.3s ease;
        }
        .nav-links a:hover { color: var(--text-primary); }
        .nav-links a:hover::after { width: 100%; }
        .nav-links a.active { color: var(--text-primary); }
        .nav-links a.active::after { width: 100%; }
        .nav-cta {
            padding: 0.6rem 1.4rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--emerald), #00d4a0);
            color: var(--navy) !important;
            border: none;
            transition: all 0.3s ease;
        }
        .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0, 245, 160, 0.3); }
        .nav-cta::after { display: none !important; }

        .hamburger {
            display: none;
            background: none; border: none;
            cursor: pointer; padding: 0.5rem; z-index: 1001;
            flex-direction: column; gap: 5px;
        }
        .hamburger span {
            display: block;
            width: 24px; height: 2px;
            background: var(--text-primary);
            border-radius: 2px;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }
        .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
        .hamburger.active span:nth-child(2) { opacity: 0; }
        .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

        /* ── SCROLL PROGRESS ── */
        .scroll-progress {
            position: fixed;
            top: 0; left: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--emerald), var(--violet));
            width: 0%;
            z-index: 1001;
            transition: width 0.1s ease-out;
        }

        /* ── SECTIONS ── */
        section { position: relative; z-index: 2; }
        section[id] { scroll-margin-top: 80px; }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 5%;
        }

        .section-label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--emerald);
            margin-bottom: 0.75rem;
            font-weight: 500;
        }

        .section-title {
            font-family: var(--font-sans);
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1;
            margin-bottom: 1rem;
        }
        .section-title .gradient {
            background: linear-gradient(135deg, var(--emerald), var(--violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ── PORTFOLIO ── */
        .portfolio {
            padding: 8rem 0;
            position: relative;
        }
        .portfolio-sub {
            font-size: 1.05rem;
            color: var(--text-secondary);
            line-height: 1.7;
            max-width: 650px;
            margin: 0 auto 3rem;
            text-align: center;
        }
        .portfolio-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 4rem;
        }
        .portfolio-grid.single-col { grid-template-columns: 1fr; max-width: 900px; margin-left: auto; margin-right: auto; }
        .portfolio-card {
            padding: 2rem;
            border-radius: 16px;
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.06);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }
        .portfolio-card:hover {
            border-color: rgba(0, 245, 160, 0.25);
            box-shadow: 0 0 40px rgba(0, 245, 160, 0.08);
            transform: translateY(-4px);
        }
        .portfolio-card-wide { grid-column: 1 / -1; }
        .portfolio-card .card-label {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--emerald);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 0.5rem;
        }
        .portfolio-card h3 {
            font-family: var(--font-sans);
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 0.3rem;
        }
        .portfolio-card h3 .gradient {
            background: linear-gradient(135deg, var(--emerald), var(--violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .portfolio-card .company-line {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--violet);
            margin-bottom: 0.75rem;
        }
        .portfolio-card p {
            font-size: 0.88rem;
            color: var(--text-secondary);
            line-height: 1.7;
        }
        .portfolio-card .achievement-list {
            list-style: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }
        .portfolio-card .achievement-list li {
            font-size: 0.88rem;
            color: var(--text-secondary);
            line-height: 1.6;
            padding-left: 1.5rem;
            position: relative;
        }
        .portfolio-card .achievement-list li::before {
            content: '\25B8';
            position: absolute;
            left: 0;
            color: var(--emerald);
            font-weight: 700;
        }
        .portfolio-card .achievement-list li strong {
            color: var(--text-primary);
            font-weight: 600;
        }
        .client-logos {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1rem;
            justify-content: center;
        }
        .client-logo {
            padding: 0.75rem 1.25rem;
            border-radius: 10px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .client-logo:hover {
            border-color: rgba(0, 245, 160, 0.3);
            color: var(--emerald);
            transform: translateY(-2px);
        }
        .portfolio-card .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-top: 0.8rem;
        }
        .portfolio-card .tag-list .tag {
            font-family: var(--font-mono);
            font-size: 0.6rem;
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            color: var(--text-muted);
        }
        .portfolio-card .cta-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--emerald);
            text-decoration: none;
            margin-top: 0.75rem;
            transition: gap 0.3s ease;
        }
        .portfolio-card .cta-link:hover { gap: 0.7rem; }
        .portfolio-card .cta-link .arrow { font-size: 1rem; }
        .portfolio-card .card-logo {
            display: inline-block;
            width: 40px;
            height: 40px;
            object-fit: contain;
            margin-right: 0.75rem;
            padding: 3px;
            border-radius: 8px;
            vertical-align: middle;
            background-color: rgba(255,255,255,0.95);
            background-clip: content-box;
            border: 1px solid rgba(255,255,255,0.2);
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        }
        .video-container {
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            background: #000;
        }
        .video-container video {
            display: block;
            width: 100%;
            height: auto;
            max-height: 400px;
        }
        .portfolio-closer {
            text-align: center;
            padding: 3rem 0;
        }
        .portfolio-closer p {
            font-size: 1.05rem;
            color: var(--text-secondary);
            max-width: 500px;
            margin: 0 auto 2rem;
        }
        .page-intro {
            padding: 8rem 0 4rem;
            text-align: center;
        }

        /* ── FOOTER ── */
        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 5%;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .footer-logo {
            font-family: var(--font-sans);
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: 2px;
            background: linear-gradient(135deg, var(--emerald), var(--violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .footer-links { display: flex; gap: 2rem; }
        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.8rem;
            transition: color 0.3s ease;
        }
        .footer-links a:hover { color: var(--text-primary); }
        .footer-copy {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        /* ── SCROLL REVEAL ── */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .reveal-delay-1 { transition-delay: 0.1s; }
        .reveal-delay-2 { transition-delay: 0.2s; }
        .reveal-delay-3 { transition-delay: 0.3s; }
        .reveal-delay-4 { transition-delay: 0.4s; }
        .reveal-delay-5 { transition-delay: 0.5s; }

        /* ── RESPONSIVE ── */
        @media (max-width: 1024px) {
            .hamburger { display: flex; }
            .nav-links {
                position: fixed;
                top: 0; right: -100%;
                width: 280px; height: 100vh;
                background: rgba(10, 14, 39, 0.95);
                backdrop-filter: blur(20px);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 2rem;
                transition: right 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
                display: flex !important;
                z-index: 1000;
            }
            .nav-links.open { right: 0; }
            .nav-links a { font-size: 1rem; }
            .portfolio-grid { grid-template-columns: 1fr; }
            .portfolio-card-wide { grid-column: span 1; }
            .footer-content { flex-direction: column; gap: 1.5rem; text-align: center; }
            .portfolio { padding: 5rem 0; }
            .page-intro { padding: 5rem 0 2rem; }
        }
        @media (max-width: 480px) {
            .portfolio-card { padding: 1.5rem; }
        }

        /* ── WEB PROJECTS ── */
        .web-section { padding: 6rem 0; position: relative; }
        .web-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
        .web-card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 2rem 1.5rem; transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease; backdrop-filter: blur(12px); display: flex; align-items: center; justify-content: center; text-align: center; min-height: 100px; }
        .web-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(0,245,160,0.15); transform: translateY(-4px); }
        .web-card .card-label { font-family: var(--font-mono); font-size: 0.92rem; letter-spacing: 1px; margin: 0; font-weight: 500; }
        .web-card .card-label a { background: linear-gradient(135deg, var(--emerald), var(--violet)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .web-card .web-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .web-card .web-header h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; margin: 0; color: var(--text-primary); }
        .web-card .web-header img { width: 36px; height: 36px; object-fit: contain; border-radius: 6px; background: rgba(255,255,255,0.95); border: 1px solid rgba(255,255,255,0.2); padding: 3px; }
        .web-card p { font-size: 0.85rem; line-height: 1.6; color: var(--text-secondary); margin: 0 0 0.75rem; }
        .web-card .web-link { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); text-decoration: none; transition: color 0.3s ease; }
        .web-card .web-link:hover { color: var(--emerald); }
        .web-card.featured { grid-column: 1 / -1; background: rgba(0,245,160,0.03); border-color: rgba(0,245,160,0.1); display: block; text-align: center; padding: 1.75rem; }
        .web-card.featured:hover { border-color: rgba(0,245,160,0.25); }
        .web-card.featured .featured-inner { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
        .web-card.featured .featured-inner .featured-content { flex: 1; }
        .web-card.featured .featured-inner .featured-logo img { width: 56px; height: 56px; object-fit: contain; border-radius: 8px; background: rgba(255,255,255,0.95); border: 1px solid rgba(255,255,255,0.2); padding: 4px; }
        .web-card.featured .card-label { margin-bottom: 0.5rem; }
        .web-card.featured h3 { font-family: var(--font-sans); font-size: 1.1rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--text-primary); }
        .web-card.featured p { font-size: 0.88rem; line-height: 1.7; color: var(--text-secondary); margin: 0; }
        .web-card.featured .featured-link { font-family: var(--font-mono); font-size: 0.7rem; color: var(--emerald); text-decoration: none; transition: color 0.3s ease; }
        .web-card.featured .featured-link:hover { color: var(--violet); }
    </style>
</head>
<body>

<div class="aurora-bg">
    <div class="aurora-blob aurora-blob-1"></div>
    <div class="aurora-blob aurora-blob-2"></div>
    <div class="aurora-blob aurora-blob-3"></div>
    <div class="aurora-blob aurora-blob-4"></div>
</div>

<canvas id="particleCanvas"></canvas>

<div class="scroll-progress" id="scrollProgress"></div>

<nav id="navbar">
    <a href="index.html" class="logo">// ASIF</a>
    <button class="hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="navLinks">
        <a href="index.html">Home</a>
        <a href="index.html#about">About</a>
        <a href="index.html#experience">Experience</a>
        <a href="index.html#skills">Skills</a>
        <a href="index.html#credentials">Credentials</a>
        <a href="index.html#contact" class="nav-cta">Let's Talk</a>
    </div>
</nav>

<!-- ── PAGE INTRO ── -->
<section class="page-intro">
    <div class="container">
        <div class="reveal" style="text-align:center;">
            <p class="section-label">// my.work</p>
            <h2 class="section-title">My <span class="gradient">Work</span></h2>
            <p class="portfolio-sub" style="font-family:var(--font-mono);font-size:0.85rem;color:var(--violet);letter-spacing:1px;margin-bottom:0.75rem;">Projects I've built, systems I've run, brands I've helped grow.</p>
            <p class="portfolio-sub" style="max-width:900px;margin-bottom:0.75rem;">I've spent the last six years working across enterprise IT, smart homes and buildings, cloud infrastructure, web development, and digital marketing, leading the adoption of ITIL‑based ITSM practices—including incident, change, and problem management—to streamline operations and reduce service disruption.</p>
        </div>
    </div>
</section>

<!-- ── PORTFOLIO ── -->
<section class="portfolio" id="portfolio">
    <div class="container">

        <div class="reveal" style="margin-bottom:1.5rem;">
            <p class="section-label" style="text-align:center;">&lt;featured.projects /&gt;</p>
            <h3 style="text-align:center;font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;">Featured <span class="gradient">Projects</span></h3>
        </div>
        <div class="portfolio-grid" style="grid-template-columns:repeat(2,1fr);">
            <div class="portfolio-card portfolio-card-wide glass-glow reveal reveal-delay-1" style="display:flex;gap:2rem;align-items:stretch;">
                <div style="flex:1;">
